<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Fire_Safety_Requirements.OccupancyTypePage"
             Title="Fire Safety Requirements"
             xmlns:controls="clr-namespace:Plugin.MauiMTAdmob.Controls;assembly=Plugin.MauiMTAdmob"
             xmlns:viewmodel="clr-namespace:Fire_Safety_Requirements.ViewModel"
             x:DataType="viewmodel:OccupancyTypeViewModel"
             xmlns:local="clr-namespace:Fire_Safety_Requirements.Converters"
             >
    <ContentPage.Resources>
        <ResourceDictionary>
            <local:BoolToOnOffConverter x:Key="BoolToOnOffConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid>
        <!-- Define rows: toggle, content, button, ad -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Toggle row -->
            <RowDefinition Height="*" />
            <!-- Content row, takes available space -->
            <RowDefinition Height="Auto" />
            <!-- Button row, takes only necessary space -->
            <RowDefinition Height="Auto" />
            <!-- Ad row -->
        </Grid.RowDefinitions>

        <!-- Offline Toggle at the top -->
        <Frame Grid.Row="0" 
               Padding="15,10" 
               Margin="10,5"
               BackgroundColor="#34495e"
               CornerRadius="8">
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="15">
                <Label Text="Offline Mode:" 
                       TextColor="White"
                       FontSize="16"
                       VerticalOptions="Center"/>
                <Switch IsToggled="{Binding IsOffline}"
                        OnColor="#27ae60"
                        ThumbColor="White"
                        VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Frame>

        <!-- Scrollable content in the second row -->
        <ScrollView Grid.Row="1">
            <StackLayout Margin="20">
                <Label 
                    Padding="10"
                    Text="Select Types of Occupancy"
                    FontSize="20"
                    FontAttributes="Bold"
                    VerticalOptions="Center" 
                    HorizontalOptions="Center" />

                <CollectionView ItemsSource="{Binding Items}"
                SelectionMode="None"
                Margin="10">
                    <CollectionView.ItemsLayout>
                        <!-- 2 columns -->
                        <GridItemsLayout Orientation="Vertical" Span="2" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="{x:Type x:String}">
                            <Frame Margin="8"
                                   Padding="10"
                                   HeightRequest="120">

                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:OccupancyTypeViewModel}}, Path=TapCommand}"
                                        CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>

                                <Grid>
                                    <Label Text="{Binding .}"
                                           FontSize="16"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           LineBreakMode="WordWrap"
                                           TextColor="Black" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </StackLayout>
        </ScrollView>

        <!-- Static Back button in the third row -->
        <Button Text="Back"
                Command="{Binding GoToMainCommand}"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Grid.Row="2"
                Margin="0,10,0,10"
                StyleClass="ElevatedButton"/>

        <!-- Ad in the fourth row -->
        <controls:MTAdView BackgroundColor="Transparent"
                           x:Name="myAds"
                           AdsId="ca-app-pub-8158194714551266/7424275353"
                           AdSize="AnchoredAdaptive"
                           IsVisible="true"
                           Grid.Row="3"/>
    </Grid>

</ContentPage>