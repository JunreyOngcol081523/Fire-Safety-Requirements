<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Fire_Safety_Requirements.OccupancyTypePage"
             Title="Fire Safety Requirements"
              xmlns:controls="clr-namespace:Plugin.MauiMTAdmob.Controls;assembly=Plugin.MauiMTAdmob"
             xmlns:viewmodel="clr-namespace:Fire_Safety_Requirements.ViewModel"
             x:DataType="viewmodel:OccupancyTypeViewModel">

    <Grid>
        <!-- Define two rows: one for the content and one for the static Back button -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <!-- Content row, takes available space -->
            <RowDefinition Height="Auto" />
            <!-- Button row, takes only necessary space -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Scrollable content in the first row -->
        <ScrollView Grid.Row="0">
            <StackLayout Margin="20">
                <Label 
                    Padding="10"
                    Text="Select Types of Occupancy"
                    FontSize="20"
                    VerticalOptions="Center" 
                    HorizontalOptions="Center" />

                <CollectionView ItemsSource="{Binding Items}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="{x:Type x:String}">
                            <Grid Padding="0,0"
                                  StyleClass="Elevation3"
                                  >
                                <Frame BackgroundColor="#5758BB" HeightRequest="65">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:OccupancyTypeViewModel}}, 
                                                      Path=TapCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Frame.GestureRecognizers>
                                    <Label Text="{Binding .}"
                                           VerticalOptions="Center"
                                           HorizontalOptions="Center"
                                           FontSize="18"
                                           />
                                </Frame>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>
        </ScrollView>

        <!-- Static Back button in the second row -->
        <Button Text="Back"
                Command="{Binding GoToMainCommand}"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Grid.Row="1"
                Margin="0,10,0,10"
                StyleClass="ElevatedButton"/>
        <!-- Add top and bottom margin for spacing -->
        <controls:MTAdView BackgroundColor="Transparent"
                                           x:Name="myAds"
                                           AdsId="ca-app-pub-8158194714551266/3269407924"
                                           AdSize="AnchoredAdaptive"
                                           IsVisible="true"
                                            Grid.Row="2"/>
    </Grid>

</ContentPage>
