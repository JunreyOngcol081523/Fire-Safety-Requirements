<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Fire_Safety_Requirements.InspectionFlowChartPage"
             xmlns:controls="clr-namespace:Plugin.MauiMtAdmob.Controls;assembly=Plugin.MauiMtAdmob"
             Title="Inspection Flow Chart">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Fit to Screen Image -->
        <Grid Grid.Row="0">
            <Image x:Name="FlowchartImage"
                   Source="inspectionflowchart.png"
                   Aspect="AspectFit"
                   Margin="10"/>
        </Grid>

        <!-- Back Button -->
        <Button Grid.Row="1"
                Text="Back"
                Clicked="OnBackButtonClicked"
                HorizontalOptions="Center"
                Margin="10"
                BackgroundColor="#c0392b"/>

        <!-- Ad -->
        <controls:MTAdView Grid.Row="2"
                           BackgroundColor="Transparent"
                           x:Name="myAds"
                           AdsId="ca-app-pub-8158194714551266/9145353467"
                           AdSize="AnchoredAdaptive"
                           IsVisible="true"/>
    </Grid>
</ContentPage>