<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Fire_Safety_Requirements.InspectionFlowChartPage"
             xmlns:controls="clr-namespace:Plugin.MauiMTAdmob.Controls;assembly=Plugin.MauiMTAdmob"
             Title="Inspection Flow Chart">
    <VerticalStackLayout>
        <ScrollView Orientation="Both" HeightRequest="600">
            <Image x:Name="FlowchartImage"
               Source="inspectionflowchart.png"
               Aspect="AspectFit" />
        </ScrollView>

        <HorizontalStackLayout  HorizontalOptions="Center">
            <Button Text="Rotate 90°"
            Clicked="OnRotateButtonClicked"
            Margin="10"/>
            <Button Text="Back"
                Clicked="OnBackButtonClicked"
                Margin="10"
                BackgroundColor="#c0392b"/>
        </HorizontalStackLayout>
        <controls:MTAdView BackgroundColor="Transparent"
                                           x:Name="myAds"
                                           AdsId="ca-app-pub-8158194714551266/9145353467"
                                           AdSize="AnchoredAdaptive"
                                           IsVisible="true"
                                            Grid.Row="2"/>
    </VerticalStackLayout>

</ContentPage>