<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Fire_Safety_Requirements.InspectionFlowChartPage"
             Title="Inspection Flow Chart">
    <VerticalStackLayout>
        <ScrollView Orientation="Both" HeightRequest="600">
            <Image x:Name="FlowchartImage"
               Source="inspectionflowchart.png"
               Aspect="AspectFit" />
        </ScrollView>

        <Button Text="Rotate 90°"
            Clicked="OnRotateButtonClicked"
            HorizontalOptions="Center"
            Margin="10"/>
    </VerticalStackLayout>

</ContentPage>