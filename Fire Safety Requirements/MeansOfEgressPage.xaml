<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Fire_Safety_Requirements.MeansOfEgressPage"
             Title="Means Of Egress Calculator"
             xmlns:viewmodel="clr-namespace:Fire_Safety_Requirements.ViewModel"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:controls="clr-namespace:Plugin.MauiMtAdmob.Controls;assembly=Plugin.MauiMtAdmob"
             x:DataType="viewmodel:MeansOfEgressViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="20">

            <!-- Top Ad Banner -->
            <controls:MTAdView BackgroundColor="Transparent"
                               x:Name="myAds"
                               AdsId="ca-app-pub-8158194714551266/4295549135"
                               AdSize="AnchoredAdaptive"
                               IsVisible="true"/>

            <!-- Page Title -->
            <Label Text="{Binding Title}" 
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,8,0,0"/>

            <!-- Input Section -->
            <VerticalStackLayout Spacing="16" Padding="0">

                <!-- Occupancy Type Picker -->
                <Border StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="Transparent">
                    <material:PickerField 
                        Title="Select Occupancy Type"
                        HorizontalOptions="Fill"
                        ItemsSource="{Binding Occupancytypes}"
                        SelectedItem="{Binding SelectedOccupancyType, Mode=TwoWay}"
                        TextColor="LightGray"
                        Margin="0"/>
                </Border>

                <!-- Floor Area Input -->
                <Border StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="Transparent">
                    <material:TextField 
                        Title="Enter Floor Area in m²" 
                        Text="{Binding Result, Mode=TwoWay}"    
                        HorizontalTextAlignment="Center"
                        HorizontalOptions="Fill"
                        Keyboard="Numeric"
                        Margin="0"/>
                </Border>
            </VerticalStackLayout>

            <!-- Results Section -->
            <VerticalStackLayout Spacing="12">
                <Label Text="Calculation Results" 
                       FontSize="18" 
                       FontAttributes="Bold"
                       Margin="0,8,0,4"/>

                <Label Text="Scroll to view all results ↓" 
                       FontSize="12" 
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                       HorizontalOptions="Center"/>

                <BoxView HeightRequest="1" 
                         Color="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                         HorizontalOptions="Fill" 
                         Margin="0,0,0,8"/>

                <!-- Results Collection -->
                <ScrollView HorizontalOptions="Fill"
                            HeightRequest="160">
                    <CollectionView ItemsSource="{Binding Items}" 
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodel:Item">
                                <Border StrokeThickness="2" 
                                        Stroke="#2E7D32"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{AppThemeBinding Light=#F1F8F4, Dark=#1B3A2F}"
                                        Margin="0,0,0,12"
                                        Padding="16">
                                    <VerticalStackLayout Spacing="12">

                                        <!-- Title -->
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <Label Grid.Column="0" 
                                                   Text="Title:" 
                                                   FontAttributes="Bold" 
                                                   FontSize="15"
                                                   TextColor="{AppThemeBinding Light=#1B5E20, Dark=#81C784}"
                                                   VerticalOptions="Center"/>
                                            <Label Grid.Column="1" 
                                                   Text="{Binding Title}" 
                                                   FontSize="15" 
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center"/>
                                        </Grid>

                                        <!-- Separator -->
                                        <BoxView HeightRequest="1" 
                                                 Color="{AppThemeBinding Light=#C8E6C9, Dark=#2E7D32}"
                                                 HorizontalOptions="Fill"/>

                                        <!-- Occupant Load -->
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <Label Grid.Column="0" 
                                                   Text="Occupant Load:" 
                                                   FontSize="14" 
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center"/>
                                            <Label Grid.Column="1" 
                                                   Text="{Binding OccupantLoad}" 
                                                   FontSize="14" 
                                                   FontAttributes="Italic"
                                                   TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}"
                                                   VerticalOptions="Center"/>
                                        </Grid>

                                        <!-- Required Number of Exits -->
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <Label Grid.Column="0" 
                                                   Text="Req. Number of Exits:" 
                                                   FontSize="14" 
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center"/>
                                            <Label Grid.Column="1" 
                                                   Text="{Binding RequiredNumberOfExits}" 
                                                   FontSize="14" 
                                                   FontAttributes="Italic"
                                                   TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}"
                                                   VerticalOptions="Center"/>
                                        </Grid>

                                        <!-- Stair Size -->
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <Label Grid.Column="0" 
                                                   Text="Stair Size:" 
                                                   FontSize="14" 
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center"/>
                                            <Label Grid.Column="1" 
                                                   Text="{Binding StairSize}" 
                                                   FontSize="14" 
                                                   FontAttributes="Italic"
                                                   TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </ScrollView>
            </VerticalStackLayout>

            <!-- Tab Section -->
            <VerticalStackLayout Spacing="8">
                <Label Text="← Swipe to navigate tabs →" 
                       FontSize="12" 
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                       HorizontalOptions="Center"/>

                <material:TabView TabPlacement="Top">

                    <!-- Remoteness of Exits Tab -->
                    <material:TabItem Title="Remoteness">
                        <material:TabItem.ContentTemplate>
                            <DataTemplate>
                                <ScrollView>
                                    <VerticalStackLayout Padding="16" Spacing="16">

                                        <!-- Dimensions Input -->
                                        <Label Text="Building Dimensions" 
                                               FontSize="16" 
                                               FontAttributes="Bold"
                                               Margin="0,0,0,8"/>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                            <Border Grid.Column="0" 
                                                    StrokeThickness="1"
                                                    Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                                    StrokeShape="RoundRectangle 8">
                                                <material:TextField 
                                                    Title="Height (m)" 
                                                    Keyboard="Numeric" 
                                                    Text="{Binding Height, Mode=TwoWay}" 
                                                    HorizontalTextAlignment="Center"
                                                    Margin="0"/>
                                            </Border>

                                            <Border Grid.Column="1" 
                                                    StrokeThickness="1"
                                                    Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                                    StrokeShape="RoundRectangle 8">
                                                <material:TextField 
                                                    Title="Width (m)" 
                                                    Keyboard="Numeric" 
                                                    Text="{Binding Width, Mode=TwoWay}" 
                                                    HorizontalTextAlignment="Center"
                                                    Margin="0"/>
                                            </Border>
                                        </Grid>

                                        <!-- Diagonal Result -->
                                        <Border StrokeThickness="1"
                                                Stroke="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                                StrokeShape="RoundRectangle 8"
                                                BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2C}">
                                            <material:TextField 
                                                Title="Diagonal Dimension" 
                                                Text="{Binding Diagonal}" 
                                                FontAttributes="Italic,Bold" 
                                                IsReadOnly="True"
                                                HorizontalTextAlignment="Center"
                                                Margin="0"/>
                                        </Border>

                                        <!-- Remoteness Requirements -->
                                        <Label Text="Minimum Exit Separation" 
                                               FontSize="16" 
                                               FontAttributes="Bold"
                                               Margin="0,8,0,8"/>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                            <Border Grid.Column="0" 
                                                    StrokeThickness="2"
                                                    Stroke="#1976D2"
                                                    StrokeShape="RoundRectangle 8"
                                                    BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#1A237E}">
                                                <material:TextField 
                                                    Title="Sprinklered" 
                                                    Text="{Binding RemotenessSprinklered}" 
                                                    FontAttributes="Italic,Bold" 
                                                    IsReadOnly="True"
                                                    HorizontalTextAlignment="Center"
                                                    Margin="0"/>
                                            </Border>

                                            <Border Grid.Column="1" 
                                                    StrokeThickness="2"
                                                    Stroke="#D32F2F"
                                                    StrokeShape="RoundRectangle 8"
                                                    BackgroundColor="{AppThemeBinding Light=#FFEBEE, Dark=#B71C1C}">
                                                <material:TextField 
                                                    Title="Non-Sprinklered" 
                                                    Text="{Binding RemotenessNonSprinklered}" 
                                                    FontAttributes="Italic,Bold" 
                                                    IsReadOnly="True"
                                                    HorizontalTextAlignment="Center"
                                                    Margin="0"/>
                                            </Border>
                                        </Grid>
                                    </VerticalStackLayout>
                                </ScrollView>
                            </DataTemplate>
                        </material:TabItem.ContentTemplate>
                    </material:TabItem>

                    <!-- Capacity of Egress Tab -->
                    <material:TabItem Title="Capacity">
                        <material:TabItem.ContentTemplate>
                            <DataTemplate>
                                <ScrollView>
                                    <VerticalStackLayout Padding="16" Spacing="16">

                                        <!-- Width Input -->
                                        <Label Text="Egress Width" 
                                               FontSize="16" 
                                               FontAttributes="Bold"
                                               Margin="0,0,0,8"/>

                                        <Border StrokeThickness="1"
                                                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                                StrokeShape="RoundRectangle 8">
                                            <material:TextField 
                                                Title="Nominal Width (mm)" 
                                                Keyboard="Numeric" 
                                                Text="{Binding NominalWidth, Mode=TwoWay}" 
                                                HorizontalTextAlignment="Center"
                                                Margin="0"/>
                                        </Border>

                                        <!-- Capacity Results -->
                                        <Label Text="Occupant Capacity" 
                                               FontSize="16" 
                                               FontAttributes="Bold"
                                               Margin="0,8,0,8"/>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                            <Border Grid.Column="0" 
                                                    StrokeThickness="2"
                                                    Stroke="#F57C00"
                                                    StrokeShape="RoundRectangle 8"
                                                    BackgroundColor="{AppThemeBinding Light=#FFF3E0, Dark=#E65100}">
                                                <material:TextField 
                                                    Title="Stairways" 
                                                    Text="{Binding CapacityinStairway}" 
                                                    FontAttributes="Italic,Bold" 
                                                    IsReadOnly="True"
                                                    HorizontalTextAlignment="Center"
                                                    Margin="0"/>
                                            </Border>

                                            <Border Grid.Column="1" 
                                                    StrokeThickness="2"
                                                    Stroke="#388E3C"
                                                    StrokeShape="RoundRectangle 8"
                                                    BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#1B5E20}">
                                                <material:TextField 
                                                    Title="Level Components" 
                                                    Text="{Binding CapacityinLevelComponents}" 
                                                    FontAttributes="Italic,Bold" 
                                                    IsReadOnly="True"
                                                    HorizontalTextAlignment="Center"
                                                    Margin="0"/>
                                            </Border>
                                        </Grid>

                                        <!-- Options -->
                                        <Label Text="Additional Options" 
                                               FontSize="16" 
                                               FontAttributes="Bold"
                                               Margin="0,8,0,8"/>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                            <Border Grid.Column="0"
                                                    StrokeThickness="1"
                                                    Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                                    StrokeShape="RoundRectangle 8"
                                                    Padding="12">
                                                <material:CheckBox 
                                                    Text="High Hazard" 
                                                    IsChecked="{Binding IsHighHazard, Mode=TwoWay}" 
                                                    IsEnabled="{Binding HaveSelectedOccupancyType}"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"/>
                                            </Border>

                                            <Border Grid.Column="1"
                                                    StrokeThickness="1"
                                                    Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                                    StrokeShape="RoundRectangle 8"
                                                    Padding="12">
                                                <material:CheckBox 
                                                    Text="Sprinklered" 
                                                    IsChecked="{Binding IsSprinklered, Mode=TwoWay}" 
                                                    IsEnabled="{Binding IsSprinkleredEnable}"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"/>
                                            </Border>
                                        </Grid>
                                    </VerticalStackLayout>
                                </ScrollView>
                            </DataTemplate>
                        </material:TabItem.ContentTemplate>
                    </material:TabItem>

                    <!-- Fire Extinguishers Tab -->
                    <material:TabItem Title="Extinguishers">
                        <material:TabItem.ContentTemplate>
                            <DataTemplate>
                                <ScrollView>
                                    <VerticalStackLayout Padding="16" Spacing="16">

                                        <!-- Area Display -->
                                        <Border StrokeThickness="1"
                                                Stroke="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                                StrokeShape="RoundRectangle 8"
                                                BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2C}">
                                            <material:TextField 
                                                Title="Floor Area (m²)" 
                                                Text="{Binding Result}" 
                                                HorizontalTextAlignment="Center" 
                                                IsReadOnly="True"
                                                FontAttributes="Bold"
                                                Margin="0"/>
                                        </Border>

                                        <Label Text="Required Fire Extinguishers by Hazard Level" 
                                               FontSize="16" 
                                               FontAttributes="Bold"
                                               Margin="0,8,0,8"/>

                                        <!-- Low Hazard -->
                                        <Border StrokeThickness="2"
                                                Stroke="#4CAF50"
                                                StrokeShape="RoundRectangle 12"
                                                BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#1B5E20}"
                                                Padding="12">
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                                <material:TextField 
                                                    Grid.Column="0"
                                                    Text="{Binding Lowhazard}" 
                                                    Title="Low Hazard" 
                                                    IsReadOnly="True" 
                                                    FontAttributes="Bold"
                                                    HorizontalTextAlignment="Center"
                                                    Margin="0"/>
                                                <material:TextField 
                                                    Grid.Column="1"
                                                    Text="15m" 
                                                    Title="Max Travel" 
                                                    IsReadOnly="True" 
                                                    FontAttributes="Italic"
                                                    HorizontalTextAlignment="Center"
                                                    Margin="0"/>
                                            </Grid>
                                        </Border>

                                        <!-- Moderate Hazard -->
                                        <Border StrokeThickness="2"
                                                Stroke="#FF9800"
                                                StrokeShape="RoundRectangle 12"
                                                BackgroundColor="{AppThemeBinding Light=#FFF3E0, Dark=#E65100}"
                                                Padding="12">
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                                <material:TextField 
                                                    Grid.Column="0"
                                                    Text="{Binding Moderatedhazard}" 
                                                    Title="Moderate Hazard" 
                                                    IsReadOnly="True" 
                                                    FontAttributes="Bold"
                                                    HorizontalTextAlignment="Center"
                                                    Margin="0"/>
                                                <material:TextField 
                                                    Grid.Column="1"
                                                    Text="12m" 
                                                    Title="Max Travel" 
                                                    IsReadOnly="True" 
                                                    FontAttributes="Italic"
                                                    HorizontalTextAlignment="Center"
                                                    Margin="0"/>
                                            </Grid>
                                        </Border>

                                        <!-- High Hazard -->
                                        <Border StrokeThickness="2"
                                                Stroke="#F44336"
                                                StrokeShape="RoundRectangle 12"
                                                BackgroundColor="{AppThemeBinding Light=#FFEBEE, Dark=#B71C1C}"
                                                Padding="12">
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                                <material:TextField 
                                                    Grid.Column="0"
                                                    Text="{Binding Highhazard}" 
                                                    Title="High Hazard" 
                                                    IsReadOnly="True" 
                                                    FontAttributes="Bold"
                                                    HorizontalTextAlignment="Center"
                                                    Margin="0"/>
                                                <material:TextField 
                                                    Grid.Column="1"
                                                    Text="10m" 
                                                    Title="Max Travel" 
                                                    IsReadOnly="True" 
                                                    FontAttributes="Italic"
                                                    HorizontalTextAlignment="Center"
                                                    Margin="0"/>
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>
                                </ScrollView>
                            </DataTemplate>
                        </material:TabItem.ContentTemplate>
                    </material:TabItem>
                </material:TabView>
            </VerticalStackLayout>

            <!-- Bottom Ad Banner -->
            <controls:MTAdView BackgroundColor="Transparent"
                               x:Name="myAds1"
                               AdsId="ca-app-pub-8158194714551266/8737357028"
                               AdSize="AnchoredAdaptive"
                               IsVisible="true"
                               Margin="0,16,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>