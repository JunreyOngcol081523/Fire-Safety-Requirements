                        <Grid Grid.Row="0"
                              Grid.Column="0"
                              Grid.ColumnSpan="1"
                              RowDefinitions="Auto" 
                              ColumnDefinitions="*"
                              HorizontalOptions="FillAndExpand">
                            --><!-- Nominal Width Entry--><!--
                            <material:TextField 
                                   Title="Enter Nominal Width in mm" 
                                   Grid.Row="0" 
                                   Grid.Column="0"
                                   Grid.ColumnSpan="1" 
                                   Text="{Binding NominalWidth, Mode=TwoWay}" 
                                   Keyboard="Numeric" 
                                   FontAttributes="Italic"  
                                   HorizontalTextAlignment="Center"
                                   VerticalOptions="Center" 
                                   HorizontalOptions="FillAndExpand" 
                                   />
                        </Grid>

                        <Grid Grid.Row="1"
                              Grid.Column="0"
