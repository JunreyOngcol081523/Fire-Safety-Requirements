                            <material:TextField Title="Stairwaiy"
                                   Grid.Row="0" 
                                   Grid.Column="0" 
                                   Text="{Binding CapacityinStairway, Mode=OneWay}" 
                                   FontAttributes="Italic" 
                                   VerticalOptions="Center" 
                                   HorizontalOptions="FillAndExpand" 
                                   IsReadOnly="True" />
                        
                        
                            --><!-- level components Entry (Read-only) --><!--
                            <material:TextField Title="Level Components" 
                                   Text="{Binding CapacityinLevelComponents}" 
                                   FontAttributes="Italic" 
                                   Grid.Row="1" 
                                   Grid.Column="1" 
                                   VerticalOptions="Center" 
                                   HorizontalOptions="FillAndExpand" 
                                   IsReadOnly="True" />
