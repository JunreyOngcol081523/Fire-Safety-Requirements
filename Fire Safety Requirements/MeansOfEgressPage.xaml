<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Fire_Safety_Requirements.MeansOfEgressPage"
             Title="Means Of Egress Calculator"
             xmlns:viewmodel="clr-namespace:Fire_Safety_Requirements.ViewModel"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:controls="clr-namespace:Plugin.MauiMTAdmob.Controls;assembly=Plugin.MauiMTAdmob"
             x:DataType="viewmodel:MeansOfEgressViewModel">

    <VerticalStackLayout>
        <controls:MTAdView BackgroundColor="Transparent"
                                           x:Name="myAds"
                                           AdsId="ca-app-pub-8158194714551266/6014003688"
                                           AdSize="AnchoredAdaptive"
                                           IsVisible="true"
                                           />
        <Label 
        Text="{Binding Title}" 
        FontSize="20"
        HorizontalOptions="Center" 
        VerticalOptions="Center" 
        HorizontalTextAlignment="Center" 
        VerticalTextAlignment="Center"/>

        <VerticalStackLayout Margin="0" Padding="0">
           
            <material:PickerField 
                    Title="Select Occupancy Type"
                    HorizontalOptions="Fill"
                    ItemsSource="{Binding Occupancytypes}"
                    SelectedItem="{Binding SelectedOccupancyType, Mode=TwoWay}"
                TextColor="LightGray"/>
            <!--Area-->

            <material:TextField Title="Enter Floor Area in m²" Text="{Binding Result, Mode=TwoWay}"    
                    HorizontalTextAlignment="Center"
                    HorizontalOptions="Fill"
                    Keyboard="Numeric"
                    Margin="0,5,0,5"/>
            <!--first scrollview-->
            
            <Label Text="Scroll down ▼" FontSize="12" HorizontalOptions="Center"/>
            <BoxView HeightRequest="1" HorizontalOptions="Fill" Margin="0,0,0,5"/>
            <ScrollView
                        HorizontalOptions="Fill"
                        HeightRequest="130"
                        Margin="0">
                <CollectionView ItemsSource="{Binding Items}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodel:Item">
                            <Frame Padding="5" 
                                   BorderColor="DarkGreen" 
                                   HorizontalOptions="Fill"
                                   StyleClass="PrimaryContainer">
                                <StackLayout Spacing="10">
                                    <!-- Title -->
                                    <Grid Padding="0" ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Title Label -->
                                        <Label Grid.Column="0" Text="Title:" FontAttributes="Bold" FontSize="14" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" Text="{Binding Title}" FontSize="14" VerticalOptions="Center" FontAttributes="Bold"/>
                                    </Grid>

                                    <!-- Occupant Load -->
                                    <Grid Padding="0" ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Label Grid.Column="0" Text="Occupant Load:" FontSize="14" VerticalOptions="Center" FontAttributes="Bold"/>
                                        <Label Grid.Column="1" Text="{Binding OccupantLoad}" FontSize="14" VerticalOptions="Center" FontAttributes="Italic"/>
                                    </Grid>

                                    <!-- Required Number of Exits -->
                                    <Grid Padding="0" ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Label Grid.Column="0" Text="Req. Number of Exits:" FontSize="14" VerticalOptions="Center" FontAttributes="Bold"/>
                                        <Label Grid.Column="1" Text="{Binding RequiredNumberOfExits}" FontSize="14" VerticalOptions="Center" FontAttributes="Italic"/>
                                    </Grid>

                                    <!-- Stair Size -->
                                    <Grid Padding="0" ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Label Grid.Column="0" Text="Stair Size:" FontSize="14" VerticalOptions="Center" FontAttributes="Bold"/>
                                        <Label Grid.Column="1" Text="{Binding StairSize}" FontSize="14" VerticalOptions="Center" FontAttributes="Italic"/>
                                    </Grid>
                                </StackLayout>
                            </Frame>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </ScrollView>
        </VerticalStackLayout>
        <Label Text="Swipe to side" FontSize="12" HorizontalOptions="Center"/>
        <material:TabView>
            <material:TabItem Title="Remoteness of Exits">
                <material:TabItem.ContentTemplate>
                    <DataTemplate>
                        <StackLayout Padding="0" Margin="0,0,0,0">
                            <Grid RowDefinitions="Auto, Auto,Auto" ColumnDefinitions="Auto,*">
                                <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" HorizontalOptions="Fill" Margin="10,10,10,0" ColumnDefinitions="*,*" >

                                    <material:TextField Title="Height in meters" Grid.Column="0"  
                                       Keyboard="Numeric" 
                                       Text="{Binding Height, Mode=TwoWay}" 
                                       HorizontalOptions="Fill" 
                                       VerticalOptions="Center"
                                       Margin="0,0,5,0"
                                       HorizontalTextAlignment="Center"
                                       />

                                    <material:TextField Grid.Column="1" Title="Width in meters" 
                                       Keyboard="Numeric" 
                                       Text="{Binding Width, Mode=TwoWay}" 
                                       HorizontalOptions="Fill" 
                                       VerticalOptions="Center"
                                       Margin="5,0,0,0"
                                       HorizontalTextAlignment="Center"/>      
                            
                            </Grid>
                                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" HorizontalOptions="Fill" Margin="10,10,10,0" ColumnDefinitions="*" >

                                <material:TextField Title="Diagonal Dimension" 
                                    Margin="0,0,5,0"
                                    Text="{Binding Diagonal}" 
                                    FontAttributes="Italic" 
                                    VerticalOptions="Center" 
                                    HorizontalOptions="Fill" 
                                    IsReadOnly="True"
                                    HorizontalTextAlignment="Center"/>


                            </Grid>
                            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" HorizontalOptions="Fill" Margin="10,10,10,10" ColumnDefinitions="*,*" >
                                <material:TextField Title="Sprinklered" 
                                    Grid.Column="0" 
                                    HorizontalTextAlignment="Center"
                                    Text="{Binding RemotenessSprinklered}" 
                                    FontAttributes="Italic" 
                                    VerticalOptions="Center" 
                                    HorizontalOptions="Fill"
                                    IsReadOnly="True"
                                    Margin="0,0,0,5"/>


                                <material:TextField Title="Non-Sprinklered" 
                                    Grid.Column="1" 
                                    Margin="5,0,0,0"
                                    Text="{Binding RemotenessNonSprinklered}"  
                                    FontAttributes="Italic" 
                                    VerticalOptions="Center" 
                                    HorizontalOptions="Fill" 
                                    IsReadOnly="True" 
                                    HorizontalTextAlignment="Center"/>

                            </Grid>
                        </Grid>
                    </StackLayout>
                    </DataTemplate>
                </material:TabItem.ContentTemplate>
            </material:TabItem>
            <material:TabItem Title="Capacity of Egress">
                <material:TabItem.ContentTemplate>
                    <DataTemplate>
                    <StackLayout Padding="0" Margin="0,0,0,0">
                    <Grid RowDefinitions="Auto, Auto,Auto" ColumnDefinitions="Auto,*">
                        <Grid Grid.Row="0" Grid.Column="0" 
                              Grid.ColumnSpan="2" 
                              HorizontalOptions="Fill" 
                              Margin="10,10,10,0" ColumnDefinitions="*" >

                            <material:TextField Title="Nominal Width in mm" Grid.Column="0"  
                               Keyboard="Numeric" 
                               Text="{Binding NominalWidth, Mode=TwoWay}" 
                               HorizontalOptions="Fill" 
                               VerticalOptions="Center"
                               Margin="0,0,5,0"
                               HorizontalTextAlignment="Center"/>   
                            

                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" HorizontalOptions="Fill" Margin="10,10,10,0" ColumnDefinitions="*,*" >
                             <material:TextField Title="Stairways" 
                                Grid.Column="0" 
                                Margin="0,0,5,0"
                                Text="{Binding CapacityinStairway}" 
                                FontAttributes="Italic" 
                                VerticalOptions="Center" 
                                HorizontalOptions="Fill" 
                                IsReadOnly="True"
                                HorizontalTextAlignment="Center"/>
                            <material:TextField Title="Level Components" 
                                Grid.Column="1" 
                                Margin="5,0,0,0"
                                Text="{Binding CapacityinLevelComponents}"  
                                FontAttributes="Italic" 
                                VerticalOptions="Center" 
                                HorizontalOptions="Fill" 
                                IsReadOnly="True" 
                                HorizontalTextAlignment="Center"/>

                        </Grid>
                        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" HorizontalOptions="Fill" Margin="10,10,10,10" ColumnDefinitions="*,*" >
                            <material:CheckBox Text ="High Hazard" 
                                           Grid.Row="2" Grid.Column="0" 
                                           IsChecked="{Binding IsHighHazard, Mode=TwoWay}" 
                                           IsEnabled="{Binding HaveSelectedOccupancyType}"
                                           HorizontalOptions="CenterAndExpand"/>

                            <material:CheckBox Text="Sprinklered"  
                                           Grid.Row="2" Grid.Column="1" 
                                           IsChecked="{Binding IsSprinklered, Mode=TwoWay}" 
                                           IsEnabled="{Binding IsSprinkleredEnable}"
                                           HorizontalOptions="CenterAndExpand"/>

                        </Grid>
                    </Grid>
                </StackLayout>   
                    </DataTemplate>
                </material:TabItem.ContentTemplate>
            </material:TabItem>
            <material:TabItem Title="Fire Extinguishers">
                <material:TabItem.ContentTemplate>
                    <DataTemplate>
                        <StackLayout Padding="5" Margin="5,5,5,5" Spacing="5">
                            <material:TextField Title="Floor area (m²)" Text="{Binding Result}" HorizontalTextAlignment="Center" IsReadOnly="True"/>
                            <Label Text="Required number of Fire Extinguishers"/>
                            <Grid RowDefinitions="*" 
                                  ColumnDefinitions="*,*" 
                                  HorizontalOptions="Fill"
                                  ColumnSpacing="10"
                                  >
                                <material:TextField Text="{Binding Lowhazard}" Title="Low Hazard" Grid.Column="0" IsReadOnly="True" HorizontalTextAlignment="Center"/>
                                <material:TextField Text="15m" Title="Travel Distance" Grid.Column="1" IsReadOnly="True" HorizontalTextAlignment="Center"/>
                            </Grid>
                            <Grid RowDefinitions="*" 
                                  ColumnDefinitions="*,*" 
                                  HorizontalOptions="Fill"
                                  ColumnSpacing="10">
                                <material:TextField Text="{Binding Moderatedhazard}" Title="Moderate Hazard" Grid.Column="0" IsReadOnly="True" HorizontalTextAlignment="Center"/>
                                <material:TextField Text="12m" Title="Travel Distance" Grid.Column="1" IsReadOnly="True" HorizontalTextAlignment="Center"/>
                            </Grid>
                            <Grid RowDefinitions="*" 
                                  ColumnDefinitions="*,*" 
                                  HorizontalOptions="Fill"
                                  ColumnSpacing="10">
                                <material:TextField Text="{Binding Highhazard}" Title="High Hazard" Grid.Column="0" IsReadOnly="True" HorizontalTextAlignment="Center"/>
                                <material:TextField Text="10m" Title="Travel Distance" Grid.Column="1" IsReadOnly="True" HorizontalTextAlignment="Center"/>
                            </Grid>
                        </StackLayout>
                    </DataTemplate>
                </material:TabItem.ContentTemplate>
            </material:TabItem>
            
        </material:TabView>
        <controls:MTAdView BackgroundColor="Transparent"
                                           x:Name="myAds1"
                                           AdsId="ca-app-pub-8158194714551266/6014003688"
                                           AdSize="AnchoredAdaptive"
                                           IsVisible="true"
                                           />
    </VerticalStackLayout>
</ContentPage>