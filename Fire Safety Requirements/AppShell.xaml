<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Fire_Safety_Requirements.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Fire_Safety_Requirements"
    Shell.FlyoutBehavior="Disabled"
    Title="Guidelines for Fire Safety Inspectors">

    
        
        <ShellContent
            Title="Guidelines for Fire Safety Inspectors"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

        <ShellContent Title="Occupancy Type Page"
            ContentTemplate="{DataTemplate local:OccupancyTypePage}"
            Route="OccupancyTypePage"/>

        <ShellContent Route="SummaryPage" ContentTemplate="{DataTemplate local:SummaryPage}" />
        <ShellContent Route="MeansOfEgressPage" ContentTemplate="{DataTemplate local:MeansOfEgressPage}" />

</Shell>
