<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Multi-targeting for Android and Windows -->
		<TargetFrameworks>net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>Fire_Safety_Requirements</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Application info -->
		<ApplicationTitle>Fire Safety Requirements</ApplicationTitle>
		<ApplicationId>com.companyname.firesafetyrequirements</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Android minimum API -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23</SupportedOSPlatformVersion>

		<!-- Windows minimum version -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<!-- Runtime identifiers -->
		<RuntimeIdentifiers Condition="$(TargetFramework.Contains('-android'))">android-arm;android-arm64;android-x86;android-x64</RuntimeIdentifiers>
		<RuntimeIdentifiers Condition="$(TargetFramework.Contains('-windows'))">win-x64;win-x86;win-arm64</RuntimeIdentifiers>
		<RuntimeIdentifier Condition="$(TargetFramework.Contains('-windows')) and '$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>

		<!-- Windows Packaging Settings -->
		<WindowsPackageType>MSIX</WindowsPackageType>
		<GenerateAppInstallerFile>True</GenerateAppInstallerFile>
		<AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
		<AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
		<AppxAutoIncrementPackageRevision>True</AppxAutoIncrementPackageRevision>
		<AppxSymbolPackageEnabled>True</AppxSymbolPackageEnabled>
		<GenerateTestArtifacts>True</GenerateTestArtifacts>
		<AppInstallerUri>C:\Publish</AppInstallerUri>
		<HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
		<PackageIcon>fsed.png</PackageIcon>
		<AndroidSigningKeyStore>ra9514guide.keystore</AndroidSigningKeyStore>
		<PackageCertificateThumbprint>6E0C20E61D1D807E3C1ADC9FA105704EE665A564</PackageCertificateThumbprint>
	</PropertyGroup>

	<!-- Debug Android Configuration -->
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-android|AnyCPU'">
		<AndroidKeyStore>True</AndroidKeyStore>
		<ApplicationId>com.junreyongcol.firesafetyrequirements</ApplicationId>
		<ApplicationTitle>RA9514 Guide</ApplicationTitle>
	</PropertyGroup>

	<!-- Release Android Configuration with Signing -->
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-android|AnyCPU'">
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>C:\repos\JunreyOngcol081523\Fire-Safety-Requirements\Fire Safety Requirements\Platforms\Android\ra9514guide.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>ra9514guide</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass>jbo081523</AndroidSigningKeyPass>
		<AndroidSigningStorePass>jbo081523</AndroidSigningStorePass>
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<RuntimeIdentifiers>android-arm;android-arm64</RuntimeIdentifiers>
		<AndroidLinkMode>SdkOnly</AndroidLinkMode>
		<!-- or None to troubleshoot -->
	</PropertyGroup>


	<!-- Debug Windows Configuration -->
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-windows10.0.19041.0|AnyCPU'">
		<ApplicationId>com.junreyongcol.firesafetyrequirements</ApplicationId>
		<ApplicationTitle>RA9514 Guide</ApplicationTitle>
	</PropertyGroup>

	<!-- Release Windows Configuration -->
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-windows10.0.19041.0|AnyCPU'">
		<ApplicationId>com.junreyongcol.firesafetyrequirements</ApplicationId>
		<ApplicationTitle>RA9514 Guide</ApplicationTitle>
	</PropertyGroup>

	<!-- Resources -->
	<ItemGroup>
		<MauiAsset Include="Resources\FireCodeRequirements\**" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Resources\AppIcon\calculator.png" />
		<None Remove="Resources\AppIcon\fire_code_revenue.png" />
	</ItemGroup>

	<ItemGroup>
		<!-- NuGet packages -->
		<PackageReference Include="CommunityToolkit.Maui" Version="13.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.11" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Plugin.MauiMTAdmob" Version="2.2.0" />
		<PackageReference Include="UraniumUI.Material" Version="2.13.0" />
	</ItemGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.png" />
		<MauiImage Include="Resources\AppIcon\calculator.png" />
		<MauiImage Include="Resources\AppIcon\fire_code_revenue.png" />
		<MauiSplashScreen Include="Resources\Splash\splash.png" />
	</ItemGroup>

	<ItemGroup>
		<MauiXaml Update="WebViewPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
	</ItemGroup>

	<ItemGroup>
		<None Update="Resources\Images\fsed.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	<ItemGroup>
		<None Include="Platforms\Android\ra9514guide.keystore" />
	</ItemGroup>


</Project>
