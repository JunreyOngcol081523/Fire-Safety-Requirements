<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Plugin.MauiMTAdmob.Controls;assembly=Plugin.MauiMTAdmob"
             x:Class="Fire_Safety_Requirements.MainPage"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             Title="Main Page">
    <Grid>
        <!-- Define three rows in the grid -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <!-- Content area above the buttons -->
            <RowDefinition Height="Auto" />
            <!-- Buttons section -->
            <RowDefinition Height="Auto" />
            <!-- Footer section -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Main content above the buttons -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout
                Padding="10,0"
                Spacing="5">
                <HorizontalStackLayout HorizontalOptions="Center">
                    <Image
                    Source="fsed.png"
                    HeightRequest="150"
                    Aspect="AspectFit"
                    SemanticProperties.Description="Fire Safety Enforcement Division's Logo" />
                    <Image
                    Source="coverpageformain.png"
                    HeightRequest="150"
                    Aspect="AspectFit"
                    SemanticProperties.Description="Fire Safety Enforcement Division's Logo" />
                </HorizontalStackLayout>
                <Label
                    Text="Hello, Fire Safety Inspectors!"
                    Style="{StaticResource SubHeadline}"
                    SemanticProperties.HeadingLevel="Level5" 
                    VerticalOptions="Center"/>

                <Label 
                    Text="{Binding preface}"
                    FontSize="10"
                    Margin="5"
                    HorizontalTextAlignment="Center"  
                    VerticalTextAlignment="Center"
                    />
                <Label Text="All rights reserved by the author of this book."
                    FontSize="15"
                    Margin="5"
                    HorizontalTextAlignment="Center"  
                    VerticalTextAlignment="Center"/>

            </VerticalStackLayout>
        </ScrollView>

        <StackLayout Grid.Row="1"
                     Orientation="Vertical"
                     HorizontalOptions="Fill"
                     VerticalOptions="End"
                     Spacing="10"
                     Margin="0,0,0,5">
            <!-- Add spacing between buttons -->
            <Button Text="Fire Safety Requirements Manual" Clicked="GoToOccupancyTypePage" HeightRequest="50" StyleClass="ElevatedButton">
                <Button.ImageSource>
                    <FileImageSource File="book.png" />
                </Button.ImageSource>
            </Button>
            <Button Text="Fire Safety Requirements Summary" Clicked="GoToSummaryPage" HeightRequest="50" StyleClass="ElevatedButton">
                <Button.ImageSource>
                    <FileImageSource File="extinguisher.png" />
                </Button.ImageSource>
            </Button>
            <Button Text="Inspection Flow Chart" Clicked="GoToInspectionFlowChartPage" HeightRequest="50" StyleClass="ElevatedButton">
                <Button.ImageSource>
                    <FileImageSource File="flowchart.png" />
                </Button.ImageSource>
            </Button>
            <Button Text="Egress Calculator" Clicked="GoToMeansOfEgressPage" HeightRequest="50" StyleClass="ElevatedButton">
                <Button.ImageSource>
                    <FileImageSource File="calculator.png" />
                </Button.ImageSource>
            </Button>
            <Button Text="Other Fees Calculator" Clicked="GoToOtherFeesCalcPage" HeightRequest="50" StyleClass="ElevatedButton">
                <Button.ImageSource>
                    <FileImageSource File="warehouse.png" />
                </Button.ImageSource>
            </Button>
        </StackLayout>


        <!-- Footer label at the bottom -->
        <Grid Grid.Row="2" HorizontalOptions="Fill">
            <material:ButtonView Tapped="GoToLink">
                <Label 
                  Text="App developed by Junrey Ongcol © 2024" 
                   FontAttributes="Italic"
                   HorizontalOptions="Center" 
                   VerticalOptions="Center" />
            </material:ButtonView>
        </Grid>
        <!-- Footer label at the bottom -->
        <Grid Grid.Row="3" HorizontalOptions="Fill">
            <controls:MTAdView BackgroundColor="Transparent"
                                           x:Name="myAds"
                                           AdsId="ca-app-pub-8158194714551266/3269407924"
                                           AdSize="AnchoredAdaptive"
                                           IsVisible="true"
                                           />
        </Grid>

    </Grid>
</ContentPage>