<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Fire_Safety_Requirements.SummaryPage"
             Title="Fire Safety Requirements Summary Table"
             xmlns:viewmodel="clr-namespace:Fire_Safety_Requirements.ViewModel"
              xmlns:controls="clr-namespace:Plugin.MauiMTAdmob.Controls;assembly=Plugin.MauiMTAdmob"
            x:DataType="viewmodel:SummaryViewModel">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <!-- This will take up remaining space for WebView -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- This will automatically size for the Button -->
        </Grid.RowDefinitions>
        <!-- Scrollable content with WebView -->
        <ScrollView Grid.Row="0">
            <WebView Source="{Binding HtmlSource}" VerticalOptions="FillAndExpand" />
        </ScrollView>

        <!-- Back Button with correct positioning -->
        <Button Text="Close"
            Command="{Binding GoBackCommand}"
            Grid.Row="1"
            VerticalOptions="End"
            HorizontalOptions="Center"
            Padding="10,5"
            MinimumHeightRequest="40"
                BackgroundColor="#c0392b"/>
        <controls:MTAdView BackgroundColor="Transparent"
                                           x:Name="myAds"
                                           AdsId="ca-app-pub-8158194714551266/8306013154"
                                           AdSize="AnchoredAdaptive"
                                           IsVisible="true"
                                            Grid.Row="2"/>
    </Grid>
</ContentPage>