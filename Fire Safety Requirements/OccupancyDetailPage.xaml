<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Fire_Safety_Requirements.OccupancyDetailPage"
             xmlns:viewmodel="clr-namespace:Fire_Safety_Requirements.ViewModel"
             x:DataType="viewmodel:OccupancyDetailViewModel"
             Title="{Binding Text}">
    <VerticalStackLayout>
        <ScrollView>
            <Grid x:Name="tableGrid" Padding="10" BackgroundColor="Red">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width=".25"/>
                    <ColumnDefinition Width=".75"/>
                </Grid.ColumnDefinitions>
                <Label Text="Column 1" Grid.Row="0" Grid.Column="0" FontAttributes="Bold" />
                <Label Text="Column 2" Grid.Row="0" Grid.Column="1" FontAttributes="Bold" />
            </Grid>
        </ScrollView>
        <Button Text="Go Back"
                Command="{Binding GoBackCommand}"
                VerticalOptions="End" 
                HorizontalOptions="Center"/>
    </VerticalStackLayout>
</ContentPage>